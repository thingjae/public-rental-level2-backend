# 백엔드 설정값 예시. 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 GitHub에 올라가지 않음)

# PostgreSQL 주소. 끝에 ?schema=level2 를 붙여 이 과제용 공간만 쓴다.
#  - 로컬: Render DB의 External 주소 + ?schema=level2&sslmode=verify-full
#  - Render 백엔드: Render DB의 Internal 주소 + ?schema=level2
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?schema=level2"

# 서버 포트 (Render에서는 자동으로 들어오므로 넣지 않아도 됨)
PORT=4000

# 요청을 허용할 프론트엔드 주소. 여러 개면 쉼표로 구분. 끝에 / 를 붙이지 않는다.
FRONTEND_ORIGIN="http://localhost:3000"
